---
import hero from '../assets/tofu-hardness-analyzer/Themachine.jpeg';
import donorPrinter from '../assets/tofu-hardness-analyzer/donor-printer.png';
import finishedMachine from '../assets/tofu-hardness-analyzer/Themachine.jpeg';
import loadCell from '../assets/tofu-hardness-analyzer/hx711-close.jpeg';
import motorWiring from '../assets/tofu-hardness-analyzer/mks42-assembly.jpeg';
import camera from '../assets/tofu-hardness-analyzer/Camera.jpeg';
import opencvOutput from '../assets/tofu-hardness-analyzer/OpenCV-output.jpg';
import wiringDiagram from '../assets/tofu-hardness-analyzer/wiring-diagram.png';

// ── Hero video ────────────────────────────────────────────────────────────
// Paste your YouTube link here once the video is uploaded. Any of these work:
//   https://www.youtube.com/watch?v=XXXXXXXXXXX
//   https://youtu.be/XXXXXXXXXXX
//   https://www.youtube.com/shorts/XXXXXXXXXXX
// Leave it blank and the hero shows the poster with a (dormant) play button.
const heroVideoUrl = 'https://youtu.be/D0Qr-mVkuc0';
const heroVideoId = (heroVideoUrl.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/) ?? [])[1] ?? '';

const shell =
	"min-h-dvh bg-white dark:bg-zinc-950 font-[system-ui,-apple-system,BlinkMacSystemFont,'Segoe_UI','Helvetica_Neue',Arial,sans-serif] text-zinc-900 dark:text-zinc-50 **:box-border";
const eyebrow = 'text-[0.6875rem] font-medium uppercase tracking-[0.28em] text-zinc-400 dark:text-zinc-500';
const label = 'text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-500';
const sectionTitle = 'text-3xl font-bold tracking-tight sm:text-4xl';

const hardware = [
	{
		name: 'Closed-loop stepper motors',
		part: 'MKS42 servo',
		body:
			'Each module integrates the driver and encoder directly onto the motor. This simplified wire management considerably and gave better positional precision than the open-loop drivers the printer shipped with.',
	},
	{
		name: 'Controller + camera',
		part: 'ESP32-S3 Nova Cam',
		body:
			'Chosen for two reasons: enough RAM to handle image capture and buffering, and a built-in camera, which is one less subsystem to integrate.',
	},
	{
		name: 'Homing',
		part: '3× limit switches',
		body:
			"Kept the printer's three original limit switches to home all axes and establish a known origin on startup.",
	},
	{
		name: 'Force sensing',
		part: 'Custom HX711 load-cell mount',
		body:
			'Replaced the print head with a custom-designed holder for an HX711 load cell, which is how the machine reads contact and compression force.',
	},
] as const;

const steps = [
	{ n: 1, title: 'Homing', body: 'On startup, the machine homes all three axes against the limit switches to establish a known origin.' },
	{ n: 2, title: 'Imaging', body: 'The build plate moves to the camera position and the ESP32 captures an image.' },
	{ n: 3, title: 'Vision processing', body: 'An OpenCV pipeline on the PC detects four fiducial markers that define the test area, counts the tofu pieces inside it, and computes each piece’s center coordinates.' },
	{ n: 4, title: 'Positioning', body: 'The ESP32 drives the X and Y axes to move the first sample under the probe.' },
	{ n: 5, title: 'Contact & height', body: 'The Z axis descends while the load cell is read continuously. The height at which force first rises marks contact, and gives the piece’s true height for free.' },
	{ n: 6, title: 'Compression curve', body: 'The probe presses a further 3 mm at a slow, controlled rate, streaming the force every 0.1 mm to capture the full force-vs-displacement curve.' },
	{ n: 7, title: 'Stiffness → class', body: 'The curve becomes an effective compressive modulus (kPa), a size-independent stiffness that grades the piece soft, firm, or extra firm.' },
	{ n: 8, title: 'Repeat', body: 'The machine indexes to the next piece and repeats until every sample in the test area has been measured.' },
] as const;

// ── How a sample is measured ────────────────────────────────────────────────
// The machine grades tofu by its effective compressive modulus (kPa), a
// size-independent stiffness, rather than by raw pushing force in grams.
const formulas = [
	{ name: 'Stress', plain: 'How hard the probe pushes, spread over its 426 mm² tip.', expr: 'force ÷ probe area', unit: 'kPa' },
	{ name: 'Strain', plain: 'How far the piece squished, relative to its own height.', expr: 'compression ÷ height', unit: 'ratio' },
	{ name: 'Modulus', plain: 'Stiffness, the same for a big or small cube of one tofu.', expr: 'stress ÷ strain', unit: 'kPa' },
] as const;

// Classification thresholds on the modulus scale (kPa)
const modLo = 16.1; // soft ↔ firm
const modHi = 30; // firm ↔ extra firm
const scaleMax = 40;
const sLeft = 40;
const sRight = 600;
const pxPerKpa = (sRight - sLeft) / scaleMax;
const xAt = (k: number) => sLeft + k * pxPerKpa;
const bands = [
	{ name: 'Soft', from: 0, to: modLo, fill: 'fill-[#93c5fd] dark:fill-[#1e3a8a]' },
	{ name: 'Firm', from: modLo, to: modHi, fill: 'fill-[#3b82f6] dark:fill-[#2563eb]' },
	{ name: 'Extra firm', from: modHi, to: scaleMax, fill: 'fill-[#1e3a8a] dark:fill-[#93c5fd]' },
] as const;
---

<div class={shell}>
	<header class="border-b border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-sm">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
			<a
				href="/product-design"
				class="text-sm text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50"
			>
				← Product design
			</a>
			<p class={`m-0 text-right ${eyebrow}`}>1.1 Tofu Hardness Analyzer</p>
		</div>
	</header>

	<!-- Hero / Project Context -->
	<section class="mx-auto max-w-6xl px-6 pt-12 pb-10 sm:pt-16 sm:pb-12">
		<p class={`m-0 ${eyebrow}`}>Project Context</p>
		<h1 class="m-0 mt-2 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
			Tofu Hardness Analyzer
		</h1>
		<p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
			A desktop-scale hardness measurement device built from a salvaged 3D printer.
		</p>
		<hr class="mt-6 max-w-2xl border-0 border-t border-zinc-200 dark:border-zinc-800" />

		<figure
			class="mt-10 m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm"
		>
			<div
				class="tha-video group relative aspect-video w-full cursor-pointer bg-black"
				data-yt-id={heroVideoId}
				role="button"
				tabindex="0"
				aria-label="Play the project video"
			>
				<img
					src={hero.src}
					width={1600}
					height={900}
					alt="Full machine at a three-quarter angle with a tofu sample loaded on the build plate"
					class="pointer-events-none absolute inset-0 h-full w-full object-cover"
					loading="eager"
					decoding="async"
				/>
				<span class="pointer-events-none absolute inset-0 bg-black/10 transition-colors duration-200 group-hover:bg-black/25"></span>
				<span
					class="pointer-events-none absolute left-1/2 top-1/2 flex h-[4.5rem] w-[4.5rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur-sm transition-transform duration-200 group-hover:scale-110 group-focus-visible:scale-110"
				>
					<svg viewBox="0 0 24 24" class="ml-1 h-8 w-8 fill-zinc-900" aria-hidden="true">
						<path d="M8 5v14l11-7z"></path>
					</svg>
				</span>
			</div>
			<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
				Press play to watch a full test cycle. The video streams here without leaving the page.
			</figcaption>
		</figure>

		<script>
			for (const el of document.querySelectorAll<HTMLElement>('.tha-video')) {
				const play = () => {
					const id = el.dataset.ytId;
					if (!id || el.querySelector('iframe')) return;
					const iframe = document.createElement('iframe');
					iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
					iframe.title = 'Project video';
					iframe.className = 'absolute inset-0 h-full w-full border-0';
					iframe.allow =
						'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
					iframe.allowFullscreen = true;
					el.innerHTML = '';
					el.appendChild(iframe);
					el.classList.remove('cursor-pointer', 'group');
					el.removeAttribute('role');
					el.removeAttribute('tabindex');
				};
				el.addEventListener('click', play);
				el.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						play();
					}
				});
			}
		</script>
	</section>

	<!-- Overview -->
	<section class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-16">
				<div class="lg:col-span-3">
					<h2 class={sectionTitle}>Overview</h2>
					<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />
					<div class="mt-8 space-y-5 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
						<p>
							A desktop-scale measurement device that determines the hardness of test samples, built to
							showcase mechatronics skills and to learn image recognition. The machine identifies tofu
							pieces on its build plate using computer vision, then performs a compression test on each
							one to classify it as soft, firm, or extra firm.
						</p>
					</div>
				</div>
				<div class="lg:col-span-2">
					<div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-6 shadow-sm sm:p-8">
						<p class={`m-0 ${label}`}>At a glance</p>
						<dl class="mt-5 space-y-4 text-sm">
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Base</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">Salvaged 3D printer</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Controller</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">ESP32-S3 Nova Cam</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Motion</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">3× MKS42 closed-loop</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Sensing</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">HX711 load cell</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Vision</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">OpenCV on PC</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Metric</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">Effective modulus (kPa)</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-zinc-500 dark:text-zinc-400">Output</dt>
								<dd class="m-0 text-right font-medium text-zinc-900 dark:text-zinc-50">Soft · Firm · Extra firm</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Started -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<h2 class={sectionTitle}>How It Started</h2>
		<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />

		<div class="mt-8 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="space-y-5 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
				<p>
					I bought a used 3D printer off Marketplace intending to harvest it for parts. After pulling the
					stepper motors and the motherboard, I decided it would be more interesting to turn it into
					something else instead.
				</p>
				<p>
					At the time I was applying for a mechanical engineering position at a food startup, so I built a
					hardness analyzer for tofu. The goal was to take real measurements and determine whether a sample
					was soft, firm, or extra firm.
				</p>
			</div>
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				<figure class="m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
					<img
						src={donorPrinter.src}
						width={donorPrinter.width}
						height={donorPrinter.height}
						alt="The donor 3D printer as purchased, before conversion"
						class="h-64 w-full object-cover sm:h-72"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-3 py-2 text-xs text-zinc-500 dark:text-zinc-400">
						Before: donor printer.
					</figcaption>
				</figure>
				<figure class="m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
					<img
						src={finishedMachine.src}
						width={finishedMachine.width}
						height={finishedMachine.height}
						alt="The finished hardness analyzer after conversion"
						class="h-64 w-full object-cover sm:h-72"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-3 py-2 text-xs text-zinc-500 dark:text-zinc-400">
						After: the analyzer.
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- Hardware Decisions -->
	<section class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<h2 class={sectionTitle}>Hardware Decisions</h2>
			<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />

			<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
				{
					hardware.map((h) => (
						<div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-6 shadow-sm sm:p-7">
							<p class={`m-0 ${label}`}>{h.name}</p>
							<h3 class="m-0 mt-3 text-lg font-bold leading-snug text-zinc-900 dark:text-zinc-50">{h.part}</h3>
							<p class="mb-0 mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">{h.body}</p>
						</div>
					))
				}
			</div>

			<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				<figure class="m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
					<img
						src={loadCell.src}
						width={loadCell.width}
						height={loadCell.height}
						alt="Custom mount with the HX711 and load cell installed on the carriage"
						class="aspect-[9/16] w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
						Load-cell assembly.
					</figcaption>
				</figure>
				<figure class="m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
					<img
						src={motorWiring.src}
						width={motorWiring.width}
						height={motorWiring.height}
						alt="One MKS42 servo mounted on the frame, showing the integrated driver and encoder"
						class="aspect-[9/16] w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
						MKS SERVO42C Closed-Loop Stepper.
					</figcaption>
				</figure>
				<figure class="m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
					<img
						src={camera.src}
						width={camera.width}
						height={camera.height}
						alt="The ESP32-S3 Nova Cam controller board with its built-in camera module"
						class="aspect-[9/16] w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
						ESP32-S3 Nova Cam mount.
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- System architecture -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<h2 class={sectionTitle}>System Architecture</h2>
		<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />
		<p class="mt-6 max-w-3xl text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
			The ESP32-S3 Nova Cam sits at the center of the build, driving motion, reading force and limit
			switches, and passing frames to the PC over USB serial for vision processing.
		</p>

		<figure class="mt-10 m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white shadow-sm">
			<div class="w-full overflow-x-auto p-4 sm:p-6">
				<img
					src={wiringDiagram.src}
					width={wiringDiagram.width}
					height={wiringDiagram.height}
					alt="Detailed wiring diagram: ESP32-S3 WROOM connected to three stepper motors and drivers (X, Y, Z), three limit switches, an HX711 amplifier and load cell, a 3.3 V rail, and a 12 V 20 A power supply."
					class="mx-auto block h-auto w-full min-w-[720px] max-w-[1100px]"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
				Full wiring diagram, the actual pin-level connections for the build.
			</figcaption>
		</figure>
	</section>

	<!-- How It Works -->
	<section class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<h2 class={sectionTitle}>How It Works</h2>
			<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />

			<div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 lg:items-start">
				<ol class="m-0 list-none space-y-6 p-0">
					{
						steps.map((s) => (
							<li class="flex gap-5">
								<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-zinc-300 dark:border-zinc-700 text-sm font-semibold tabular-nums text-zinc-500 dark:text-zinc-400">
									{s.n}
								</span>
								<div>
									<p class="m-0 font-bold text-zinc-900 dark:text-zinc-50">{s.title}</p>
									<p class="mb-0 mt-1 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">{s.body}</p>
								</div>
							</li>
						))
					}
				</ol>

				<!-- Process flowchart -->
				<figure class="m-0 lg:sticky lg:top-6 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-sm">
					<div class="w-full overflow-x-auto p-4 sm:p-6">
						<svg viewBox="0 0 640 1120" class="mx-auto block h-auto w-full min-w-[420px] max-w-[520px] text-zinc-500 dark:text-zinc-400" role="img" aria-label="Process flowchart of the eight steps, with a contact-detection decision that loops while descending and a per-piece loop back to positioning.">
							<defs>
								<marker id="thaFlowArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
									<path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
								</marker>
							</defs>

							<!-- vertical connectors -->
							<g stroke="currentColor" stroke-width="2" fill="none" marker-end="url(#thaFlowArrow)">
								<path d="M300 70 V100" />
								<path d="M300 164 V194" />
								<path d="M300 258 V288" />
								<path d="M300 352 V382" />
								<path d="M300 446 V476" />
								<path d="M300 540 V558" />
								<!-- Yes from contact diamond down to compress -->
								<path d="M300 662 V692" />
								<path d="M300 756 V786" />
								<path d="M300 850 V868" />
								<!-- No from more-pieces diamond down to end -->
								<path d="M300 972 V1002" />
							</g>

							<!-- No branch: keep descending (contact diamond left vertex -> back into step 5) -->
							<g stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="6 5" marker-end="url(#thaFlowArrow)">
								<path d="M208 610 H90 V508 H170" />
							</g>
							<!-- Yes branch: next piece (more-pieces diamond right vertex -> back into step 4) -->
							<g stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="6 5" marker-end="url(#thaFlowArrow)">
								<path d="M392 920 H550 V414 H430" />
							</g>

							<!-- branch labels -->
							<g fill="currentColor" font-family="system-ui,sans-serif" font-size="12.5">
								<text x="150" y="567" text-anchor="middle">No, keep</text>
								<text x="150" y="583" text-anchor="middle">descending</text>
								<text x="313" y="683" text-anchor="start">Yes</text>
								<text x="490" y="626" text-anchor="middle">Yes,</text>
								<text x="490" y="642" text-anchor="middle">next piece</text>
								<text x="313" y="992" text-anchor="start">No, done</text>
							</g>

							<!-- start / end pills -->
							<g>
								<rect x="220" y="20" width="160" height="50" rx="25" fill="none" stroke="currentColor" stroke-width="2" />
								<text x="300" y="51" text-anchor="middle" fill="currentColor" font-family="system-ui,sans-serif" font-size="15" font-weight="700">Start</text>
								<rect x="220" y="1002" width="160" height="50" rx="25" fill="none" stroke="currentColor" stroke-width="2" />
								<text x="300" y="1033" text-anchor="middle" fill="currentColor" font-family="system-ui,sans-serif" font-size="15" font-weight="700">Done</text>
							</g>

							<!-- process boxes -->
							<g fill="none" stroke="currentColor" stroke-width="2">
								<rect x="170" y="100" width="260" height="64" rx="10" />
								<rect x="170" y="194" width="260" height="64" rx="10" />
								<rect x="170" y="288" width="260" height="64" rx="10" />
								<rect x="170" y="382" width="260" height="64" rx="10" />
								<rect x="170" y="476" width="260" height="64" rx="10" />
								<rect x="170" y="692" width="260" height="64" rx="10" />
								<rect x="170" y="786" width="260" height="64" rx="10" />
							</g>
							<g fill="currentColor" font-family="system-ui,sans-serif" font-weight="600" font-size="13">
								<text x="300" y="130" text-anchor="middle">1 · Home all axes</text>
								<text x="300" y="224" text-anchor="middle">2 · Capture image</text>
								<text x="300" y="318" text-anchor="middle">3 · Vision: markers, count, centers</text>
								<text x="300" y="412" text-anchor="middle">4 · Position sample (X / Y)</text>
								<text x="300" y="506" text-anchor="middle">5 · Z descends, find contact height</text>
								<text x="300" y="722" text-anchor="middle">6 · Compress 3 mm, stream force curve</text>
								<text x="300" y="816" text-anchor="middle">7 · Modulus → soft / firm / extra</text>
							</g>

							<!-- decision diamonds (accent) -->
							<g fill="none" stroke="#2563eb" class="dark:stroke-[#60a5fa]" stroke-width="2.5">
								<path d="M300 558 L392 610 L300 662 L208 610 Z" />
								<path d="M300 868 L392 920 L300 972 L208 920 Z" />
							</g>
							<g fill="#1e3a8a" class="dark:fill-[#bfdbfe]" font-family="system-ui,sans-serif" font-size="13" font-weight="600">
								<text x="300" y="606" text-anchor="middle">Load threshold</text>
								<text x="300" y="623" text-anchor="middle">exceeded?</text>
								<text x="300" y="916" text-anchor="middle">More pieces</text>
								<text x="300" y="933" text-anchor="middle">to test?</text>
							</g>
						</svg>
					</div>
					<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
						Process flow: contact detection loops until the load threshold is met, then each piece indexes back to positioning.
					</figcaption>
				</figure>
			</div>

			<!-- OpenCV output -->
			<figure class="mt-14 m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800/70 shadow-sm">
				<img
					src={opencvOutput.src}
					width={opencvOutput.width}
					height={opencvOutput.height}
					alt="Processed camera frame with four fiducial markers highlighted, detected tofu pieces outlined, and center points marked"
					class="h-auto w-full object-contain"
					loading="lazy"
					decoding="async"
				/>
				<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
					OpenCV output: markers define the test area; each detected piece is outlined with its center marked.
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- How a sample is measured -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<h2 class={sectionTitle}>Measuring Stiffness, Not Force</h2>
		<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />

		<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-16">
			<div class="lg:col-span-3 space-y-5 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
				<p>
					The machine grades each piece by its
					<strong class="font-semibold text-zinc-900 dark:text-zinc-50">stiffness</strong>, an effective
					compressive modulus in kilopascals. Stiffness is a property of the tofu itself, so it stays the
					same whether a piece is cut thick or thin.
				</p>
				<p>
					That independence is the point: tofu comes in all thicknesses, and a thinner slice compresses more
					under the same press than a thick one. Reading stiffness rather than raw push force lets the
					classifier compare pieces of any size on equal footing. The machine captures the full
					force-vs-compression curve on every press to compute it.
				</p>
			</div>
			<aside class="lg:col-span-2">
				<div class="h-full rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 p-6 shadow-sm sm:p-7">
					<p class={`m-0 ${label}`}>Why it matters</p>
					<p class="mb-0 mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
						A 147&nbsp;g reading <em>sounded</em> firm, but it came from a thin 13.9&nbsp;mm piece
						compressed to 22&nbsp;% of its height. Judged by stiffness, that tofu is correctly
						<strong class="font-semibold text-zinc-900 dark:text-zinc-50">soft</strong>.
					</p>
				</div>
			</aside>
		</div>

		<!-- The three quantities -->
		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
			{
				formulas.map((f, i) => (
					<div class={`rounded-2xl border p-6 shadow-sm ${i === 2 ? 'border-blue-200 dark:border-blue-900/60 bg-blue-50/60 dark:bg-blue-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950'}`}>
						<div class="flex items-baseline justify-between gap-2">
							<p class="m-0 text-base font-bold text-zinc-900 dark:text-zinc-50">{f.name}</p>
							<span class="text-xs font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500">{f.unit}</span>
						</div>
						<p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{f.plain}</p>
						<p class="mt-4 mb-0 rounded-lg bg-zinc-100 dark:bg-zinc-900 px-3 py-2 text-center font-mono text-sm text-zinc-800 dark:text-zinc-200">{f.expr}</p>
					</div>
				))
			}
		</div>

		<!-- Classification scale -->
		<figure class="mt-10 m-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-sm">
			<div class="w-full overflow-x-auto p-4 sm:p-8">
				<svg viewBox="0 0 640 150" class="mx-auto block h-auto w-full min-w-[420px] max-w-[600px] text-zinc-500 dark:text-zinc-400" role="img" aria-label="Classification scale by effective modulus: soft below 16.1 kilopascals, firm from 16.1 to 30, extra firm above 30.">
					<!-- class labels above each band -->
					<g fill="currentColor" font-family="system-ui,sans-serif" font-size="14" font-weight="600" text-anchor="middle">
						{bands.map((b) => <text x={xAt((b.from + b.to) / 2)} y={40}>{b.name}</text>)}
					</g>

					<!-- bands -->
					{bands.map((b) => {
						const x = xAt(b.from);
						const w = xAt(b.to) - x - (b.to < scaleMax ? 4 : 0);
						return <rect x={x} y={54} width={w} height={44} rx={6} class={b.fill} />;
					})}

					<!-- boundary ticks + values -->
					<g stroke="currentColor" stroke-width="1.5">
						<line x1={xAt(modLo)} y1={100} x2={xAt(modLo)} y2={112} />
						<line x1={xAt(modHi)} y1={100} x2={xAt(modHi)} y2={112} />
					</g>
					<g fill="currentColor" font-family="system-ui,sans-serif" font-size="13" text-anchor="middle">
						<text x={xAt(modLo)} y={128}>16.1</text>
						<text x={xAt(modHi)} y={128}>30</text>
						<text x={sLeft} y={128} text-anchor="start">0</text>
						<text x={sRight} y={128} text-anchor="end">kPa →</text>
					</g>
				</svg>
			</div>
			<figcaption class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">
				Soft below 16.1&nbsp;kPa · firm up to 30&nbsp;kPa · extra firm above. Thresholds set from three tofus of known firmness, and refined as more are tested.
			</figcaption>
		</figure>
	</section>

	<!-- Results -->
	<section class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<h2 class={sectionTitle}>Results</h2>
			<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />
			<div class="mt-8 max-w-3xl space-y-5 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
				<p>
					The machine reliably locates multiple samples in a single pass and classifies each one against
					calibrated stiffness (modulus) thresholds without operator input beyond loading the plate.
				</p>
			</div>
		</div>
	</section>

	<!-- Future Improvements -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<h2 class={sectionTitle}>Future Improvements</h2>
		<hr class="mt-6 border-0 border-t border-zinc-200 dark:border-zinc-800" />
		<div class="mt-8 max-w-3xl space-y-5 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
			<p>
				Next, I plan to generate stress-strain curves from the load-cell data using MATLAB. After that
				I'll likely convert the machine into a plotter, since I don't have an ongoing need for a hardness
				analyzer. I built this to learn image recognition and to prove I could take a project like this
				from salvaged parts to a working system. It served both purposes.
			</p>
		</div>
	</section>

	<footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-10 text-sm text-zinc-500 dark:text-zinc-400">
			<span>Bora Tavman · Tofu Hardness Analyzer</span>
			<a
				href="/product-design"
				class="text-zinc-900 dark:text-zinc-50 underline decoration-zinc-300 dark:decoration-zinc-600 underline-offset-4 transition-colors hover:decoration-zinc-900 dark:hover:decoration-zinc-300"
			>
				Back to contents
			</a>
		</div>
	</footer>
</div>
